
mysql> SELECT employee_id, first_name, last_name, salary
    -> FROM employees;
+-------------+------------+-----------+----------+
| employee_id | first_name | last_name | salary   |
+-------------+------------+-----------+----------+
|           1 | Ellen      | Abel      | 50000.00 |
|           2 | Sundar     | Ande      | 60000.00 |
|           3 | David      | Austin    | 45000.00 |
|           4 | Nancy      | Green     | 55000.00 |
+-------------+------------+-----------+----------+
4 rows in set (0.00 sec)
mysql> SELECT first_name,
    ->        CASE
    ->            WHEN first_name REGEXP '[0-9]' THEN 'Contains Number'
    ->            ELSE 'No Number'
    ->        END AS `Number Check`
    -> FROM employees;
+------------+--------------+
| first_name | Number Check |
+------------+--------------+
| Ellen      | No Number    |
| Sundar     | No Number    |
| David      | No Number    |
| Nancy      | No Number    |
+------------+--------------+
4 rows in set (0.04 sec)
